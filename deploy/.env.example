# 复制为 deploy/.env 后再用于生产 compose；不要提交真实密码。
POSTGRES_DB=pet_memorial
POSTGRES_USER=pet_memorial
# 对外域名，例如 memorial.example.com。DNS A 记录必须先指向 Oracle 公网 IP，Caddy 才能自动签发 HTTPS 证书。
SITE_DOMAIN=memorial.example.com
# 至少 20 位的随机值；示例值会被生产启动门禁拒绝。
POSTGRES_PASSWORD=replace-with-a-long-random-password
WEB_PORT=8081
# 生产部署必须由 HTTPS 反向代理终止 TLS；会话 Cookie 仅在安全连接上传输。
SESSION_COOKIE_SECURE=true
# 首位运营管理员的邮箱，首次登录后会被赋予 ADMIN；配置完成后建议清空。
BOOTSTRAP_ADMIN_EMAILS=
# 至少 32 位的随机值；用于不可逆的访客 HMAC 指纹，不得使用示例值。
VISITOR_FINGERPRINT_SECRET=replace-with-a-long-random-visitor-fingerprint-secret
